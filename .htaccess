Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

RewriteEngine On

# HTTPS obligatoire en production (le certificat est fourni par o2switch / AutoSSL).
# Ignoré en local (localhost, 127.0.0.1).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Fichiers cachés (.git, .env…) interdits, sauf .well-known (validation des certificats)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Code applicatif, configuration, scripts SQL et documents de travail interdits au public
RewriteRule ^(app|config|database|docs)(/|$) - [F,L]
RewriteRule \.(sql|md|drawio|docx|py|log|ini)$ - [F,L,NC]

# Les fichiers et dossiers existants (assets) sont servis tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tout le reste passe par le contrôleur frontal
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression des réponses texte
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache navigateur des fichiers statiques (les URL portent un numéro de version ?v=)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>
